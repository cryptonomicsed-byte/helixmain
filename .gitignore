node_modules/
__pycache__/
*.pyc
*.pyo
dist/
build/
.env
*.log
.DS_Store
*.tmp
tmp/

# Swarm runtime exhaust
dna-foundry/swarm/.venv/
dna-foundry/swarm/a2a/run_*.jsonl
dna-foundry/swarm/memory/

# Hugo build OUTPUT. site/ is source (layouts, content, hugo.toml, build script)
# and stays tracked — only what `hugo` generates is ignored.
site/public/
site/resources/
site/.hugo_build.lock
site/content/b/
# These two hold BOTH generated output (companies/*.json from build-from-cards.sh,
# qr/*.png from the publisher) AND hand-authored source (the landing's css/js and
# vendored libs, data/pricing.json). An ignored DIRECTORY cannot have a file
# re-included inside it, so these are written `dir/*` — that leaves the directory
# itself walkable and lets the ! rules below actually take effect.
site/data/*
!site/data/pricing.json
site/static/*
!site/static/landing.css
!site/static/landing.js
!site/static/vendor/

# Per-run compiled card output. Everything under compiled/ is generated; the
# demo cards that ARE tracked stay tracked — ignore rules never apply to tracked
# files. (Notably dna_c1640d90_v4/openshell-policy.yaml, which ws5-boot.sh and
# deploy/zeroclaw/ws5-job3-apply.sh READ.) Add a new fixture with `git add -f`.
dna-foundry/compiled/*

# Cards the API extracts at /extract — runtime output, not source. The single
# committed demo fixture in this dir stays tracked (tracked files are unaffected
# by ignore rules).
dna-foundry/api/data/cards/dna_*.json

{"$id":"https://helixmain.ai/contracts/task.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Unit of scheduled work. Tasks are claimed by agents, executed by workers, and closed with receipts — never just messages.","properties":{"assigned_agent_id":{"type":["string","null"]},"budget_usd":{"minimum":0,"type":["number","null"]},"created_at":{"format":"date-time","type":"string"},"deadline":{"format":"date-time","type":["string","null"]},"depends_on":{"description":"Task IDs that must complete first.","items":{"type":"string"},"type":"array"},"goal_id":{"type":"string"},"id":{"pattern":"^task_[a-z0-9]{8,}$","type":"string"},"organization_id":{"type":"string"},"parent_task_id":{"type":["string","null"]},"priority":{"enum":["low","normal","high","urgent"],"type":"string"},"project_id":{"type":["string","null"]},"receipt_ids":{"items":{"type":"string"},"type":"array"},"required_capabilities":{"items":{"type":"string"},"type":"array"},"state":{"enum":["queued","claimed","planning","executing","verifying","blocked","awaiting_approval","completed","failed","cancelled"],"type":"string"},"title":{"minLength":1,"type":"string"},"updated_at":{"format":"date-time","type":"string"}},"required":["id","organization_id","goal_id","title","state"],"title":"Task","type":"object"}
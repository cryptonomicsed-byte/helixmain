{"$id":"https://helixmain.ai/contracts/verification.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Independent check that the tool result actually satisfied the action's intent. A second pair of eyes before the receipt is minted.","properties":{"checked_at":{"format":"date-time","type":"string"},"checks":{"description":"Named checks and pass/fail, e.g. order_id matches, customer notified.","items":{"properties":{"name":{"type":"string"},"passed":{"type":"boolean"}},"required":["name","passed"],"type":"object"},"type":"array"},"id":{"pattern":"^ver_[a-z0-9]{8,}$","type":"string"},"method":{"enum":["rule","model_judge","human"],"type":"string"},"organization_id":{"type":"string"},"tool_result_id":{"type":"string"},"verdict":{"enum":["pass","fail"],"type":"string"}},"required":["id","organization_id","tool_result_id","method","verdict"],"title":"Verification","type":"object"}